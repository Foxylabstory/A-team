# Для публикации: production + HTTPS и реальный домен.
NODE_ENV=development
SITE_URL=
HOST=127.0.0.1
PORT=3000

# При nginx на этой же машине: loopback. Nginx должен перезаписывать X-Forwarded-For.
TRUST_PROXY=

# Пути относительно server/. База и резервные копии — вне public/.
DATA_DIR=data
BACKUP_DIR=backups

# Рабочее значение, которое оператор должен согласовать с целью обработки.
LEAD_RETENTION_DAYS=90

# Только уведомление «Поступила новая заявка», без имени и телефона.
# Оба значения оставьте пустыми до подключения бота.
TG_BOT_TOKEN=
TG_CHAT_ID=

# Для российского хостинга: HTTPS-адрес отдельного загрузчика и общий секрет (32+ символа).
# Подробности в instagram-loader/README.md. Токен Instagram остаётся на загрузчике.
IG_NEWS_FEED_URL=
IG_NEWS_FEED_TOKEN=
IG_NEWS_HASHTAG=новости
IG_NEWS_ACCOUNT=antipov__team
NEWS_AUTO_UPDATE=true
# Для собственного фонового загрузчика: true. Официальный API может работать синхронно.
NEWS_ASYNC_IMPORT=true

# Прямое подключение, только если сервер имеет доступ к API и фотографиям Meta.
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_LOGIN=facebook
IG_API_VERSION=v25.0

# Пароль задаётся интерактивно: npm run admin:password
# ADMIN_TOKEN больше не используется.

# Серверный ключ для ежедневного сбора отзывов; не передаётся в браузер.
APIFY_TOKEN=
REVIEWS_AUTO_UPDATE=true
