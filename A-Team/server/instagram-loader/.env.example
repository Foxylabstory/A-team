# Только для отдельного загрузчика. Доступа к заявкам и базе клуба здесь нет.
HOST=127.0.0.1
PORT=3100
NEWS_LOADER_TOKEN=
# instaloader: открытый аккаунт, без регистрации разработчика Meta и без Apify.
# official: существующий официальный API с IG_USER_ID / IG_ACCESS_TOKEN.
IG_SOURCE=instaloader
IG_PYTHON=python3
IG_SCAN_LIMIT=100
# Необязательно. Только если Instagram потребует вход: путь к закрытому JSON-файлу сессии.
IG_SESSION_FILE=
NEWS_LOADER_DATA_DIR=private
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_LOGIN=instagram
IG_API_VERSION=v25.0
IG_NEWS_HASHTAG=новости
IG_NEWS_ACCOUNT=antipov__team
